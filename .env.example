# Copy to .env (local) or add as secrets on the host. Never commit real keys.
# At least one key enables AI component detection; Gemini is recommended (it is trained to return bounding boxes).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_MODEL=gpt-4.1-mini

# Optional: protect the hosted key. Visitors must enter this code to use the server-side key
# (they can always paste their own key instead). Leave empty to allow anyone.
APP_ACCESS_CODE=

# Max AI calls per browser session when using the server-side key.
AI_CALLS_PER_SESSION=12
